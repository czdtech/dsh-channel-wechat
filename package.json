{
  "name": "dsh-channel-wechat",
  "version": "0.1.0",
  "description": "Personal WeChat channel for DeepSeek Harness, as an in-process host plugin",
  "license": "MIT",
  "author": "czdtech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czdtech/dsh-channel-wechat.git"
  },
  "bugs": {
    "url": "https://github.com/czdtech/dsh-channel-wechat/issues"
  },
  "homepage": "https://github.com/czdtech/dsh-channel-wechat#readme",
  "keywords": [
    "deepseek-harness",
    "cordis-plugin",
    "wechat",
    "ilink"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "login": "node lib/login.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "qrcode": "^1.5.4",
    "undici": "^7.16.0"
  }
}
